{
  "name": "@xompass/web-sdk",
  "version": "0.35.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "oxlint --config .oxlintrc.json src && tsc --noEmit",
    "lint:fix": "oxlint --fix --config .oxlintrc.json src",
    "format": "oxfmt --config .oxfmtrc.json --write src vite.config.ts package.json tsconfig.json tsconfig.node.json tsconfig.build.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --config .oxfmtrc.json --threads=1 --check src vite.config.ts package.json tsconfig.json tsconfig.node.json tsconfig.build.json .oxlintrc.json .oxfmtrc.json",
    "prepublishOnly": "pnpm run build",
    "publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "24.13.3",
    "oxfmt": "0.56.0",
    "oxlint": "1.74.0",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.7.0"
}
